# --- Obligatorias ---
DATABASE_URL="postgresql://barber:barber@localhost:5432/barberflow"
JWT_SECRET="cambiar-por-un-valor-largo-y-secreto"
JWT_EXPIRES_IN="1d"

# --- URLs públicas (links en emails y retorno de Mercado Pago) ---
WEB_URL="https://barberflow-web-six.vercel.app/"
API_PUBLIC_URL="https://barberflow-api-9feo.onrender.com"

# --- Modo demo: botón "Probar el panel" (solo lectura, datos ocultos) ---
DEMO_MODE="true"

# --- Tareas programadas (recordatorios y señas vencidas) ---
# Lo usa el workflow keep-alive para llamar a POST /v1/jobs/run
CRON_SECRET=""

# --- Emails (Resend, plan gratis). Vacío = no se envían, solo se loguean ---
RESEND_API_KEY=""
EMAIL_FROM="Nacho Barbershop <onboarding@resend.dev>"

# --- Seña con Mercado Pago. Vacío = los turnos se confirman sin seña ---
MP_ACCESS_TOKEN=""
MP_WEBHOOK_SECRET=""
DEPOSIT_PERCENT="30"
PAYMENT_TIMEOUT_MINUTES="20"
